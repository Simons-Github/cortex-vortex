# Supabase project credentials.
# Find these in your Supabase project settings under "API".
# Copy this file to `.env` and fill in your values: `cp .env.example .env`
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gemini API key — server-side only, deliberately WITHOUT a VITE_ prefix so
# it is never inlined into the client bundle. Get one at
# https://aistudio.google.com/apikey. If unset, the Gemini endpoints fall
# back to mock data automatically (unless a signed-in user has stored their
# own key).
GEMINI_API_KEY=

# Optional: override the Gemini model used by the server (defaults to
# gemini-3.6-flash).
# GEMINI_MODEL=

# BYOK (signed-in users storing their own Gemini key). Both are server-only —
# never prefix with VITE_. Generate the encryption secret with:
#   openssl rand -base64 32
# The service role key is in Supabase → Project Settings → API. It is used
# only to read/write encrypted keys via RPCs that reject non-service_role JWTs.
# If either is unset, the Settings form for a personal key stays disabled.
# USER_KEY_ENCRYPTION_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
