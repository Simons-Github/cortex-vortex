# Supabase project credentials.
# Find these in your Supabase project settings under "API".
# Copy this file to `.env` and fill in your values: `cp .env.example .env`
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gemini API key — server-side only, deliberately WITHOUT a VITE_ prefix so
# it is never inlined into the client bundle. Get one at
# https://aistudio.google.com/apikey. If unset, the Gemini endpoints fall
# back to mock data automatically.
GEMINI_API_KEY=

# Optional: override the Gemini model used by the server (defaults to
# gemini-3.6-flash).
# GEMINI_MODEL=
